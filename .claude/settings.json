{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/root/projects/DReader/.claude/hooks/scripts/ops-trail-logger.sh",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "/root/projects/DReader/.claude/hooks/scripts/failure-logger.sh",
            "timeout": 2000,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "/root/projects/DReader/.claude/hooks/scripts/pre-compact.sh",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/root/projects/DReader/.claude/hooks/scripts/write-guard.sh",
            "timeout": 2000,
            "type": "command"
          },
          {
            "command": "/root/projects/DReader/.claude/hooks/scripts/repo-guard.sh",
            "timeout": 2000,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "/root/projects/DReader/.claude/hooks/scripts/bash-guard.sh",
            "timeout": 2000,
            "type": "command"
          },
          {
            "command": "/root/projects/DReader/.claude/hooks/scripts/bead-gate.sh",
            "timeout": 2000,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/root/projects/DReader/.claude/hooks/scripts/session-start.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
