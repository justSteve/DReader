# working data — never commit (see CLAUDE.md Housekeeping)
dossiers/*/runs/
dossiers/*/frames-*/
.venv/
.env
# transfer vehicles
files.zip
# Windows ADS metadata
*:Zone.Identifier

# generated on demand for sibling zgents, not committed
findings-export*.json
# YouTube login cookies for members-only downloads — never commit
cookies*.txt
newsletters/tradebrigade/letters/
newsletters/tradebrigade/data/

# generated snapshot of the cards for reading — rerun `mread.py browse`
browser.html

# generated data layer for the card-reader UI — rerun `python3 build_corpus.py`
corpus.json

# fetched YouTube auto-captions — substrate for READ.md, rerun `fetch_transcripts.py`
dossiers/*/transcript.txt
dossiers/*/transcript.vtt
design/reading-ui/yt-analyst-reads.html

# assembled reading interface — rerun `python3 build_reader.py`
reader.html

# YouTube cover images for the reader banner — rerun `python3 fetch_thumbs.py`
dossiers/*/thumb.jpg

# Gemini Files API handle for a local capture — expires 48 h after upload, machine-specific
dossiers/*/upload.json
